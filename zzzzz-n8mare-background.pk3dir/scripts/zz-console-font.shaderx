gfx/2d/bigchars
{
	nopicmip
	nomipmaps
	if ( $n8_consoleFont == 1 )
	{
		map gfx/2d/con_verdana.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbgen vertex
    }
	else
	{
		map gfx/2d/bigchars.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbgen vertex
	}
}

